-// ChangeSeatText changes a seat when the confirmation code is valid.
+// normalizeSeat accepts only the demo layout and returns a canonical coordinate.
+func normalizeSeat(requestedSeat string) (string, bool) {
+	seat := strings.ToUpper(strings.TrimSpace(requestedSeat))
+	if len(seat) < 2 {
+		return "", false
+	}
+	column := seat[len(seat)-1]
+	if column < 'A' || column > 'F' {
+		return "", false
+	}
+	row := 0
+	for i := 0; i < len(seat)-1; i++ {
+		if seat[i] < '0' || seat[i] > '9' {
+			return "", false
+		}
+		// Bound the accumulator before another digit can cause overflow.
+		// Arbitrarily many leading zeroes remain valid.
+		row = row*10 + int(seat[i]-'0')
+		if row > 30 {
+			return "", false
+		}
+	}
+	if row == 0 {
+		return "", false
+	}
+	return fmt.Sprintf("%d%c", row, column), true
+}
