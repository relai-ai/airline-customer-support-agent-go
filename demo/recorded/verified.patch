+func preserveBookings(t *testing.T) {
+	t.Helper()
+	snapshot := make(map[string]Booking, len(bookings))
+	for code, booking := range bookings {
+		snapshot[code] = *booking
+	}
+	t.Cleanup(func() {
+		for code, booking := range snapshot {
+			*bookings[code] = booking
+		}
+	})
+}
+
+func assertSeatRejection(t *testing.T, result, code, before, reason string) {
+	t.Helper()
+	var rejection struct {
+		Status           string `json:"status"`
+		Mutated          *bool  `json:"mutated"`
+		ConfirmationCode string `json:"confirmation_code"`
+		SeatBefore       string `json:"seat_before"`
+		SeatAfter        string `json:"seat_after"`
+		Reason           string `json:"reason"`
+	}
+	if err := json.Unmarshal([]byte(result), &rejection); err != nil {
+		t.Fatalf("invalid rejection %q: %v", result, err)
+	}
+	if rejection.Status != "rejected" || rejection.Mutated == nil || *rejection.Mutated ||
+		rejection.ConfirmationCode != code || rejection.SeatBefore != before || rejection.SeatAfter != before ||
+		strings.TrimSpace(rejection.Reason) == "" || !strings.Contains(rejection.Reason, reason) {
+		t.Errorf("incorrect rejection evidence: %s", result)
+	}
+	if bookings[code].Seat != before {
+		t.Errorf("rejection changed %s from %s to %s", code, before, bookings[code].Seat)
+	}
+}
