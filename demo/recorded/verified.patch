+package airline
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"sync"
+	"testing"
+)
+
+// Inspect real outbound requests from every runner, without an ATIF recorder.
+// Mock replies exercise normal dispatch and native current-response results;
+// they do not test semantic model compliance.
+func TestProvidersConsumePriorExecutionEvidence(t *testing.T) {
+	for _, provider := range []string{"relai", "openai", "anthropic"} {
+		t.Run(provider, func(t *testing.T) {
+			const result = "Ari is booked on ORD to BOS. Seat 7B."
+			var requests []map[string]any
+			var requestMu sync.Mutex
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+				var body map[string]any
+				if err := json.NewDecoder(req.Body).Decode(&body); err != nil {
+					t.Error(err)
+					w.WriteHeader(http.StatusBadRequest)
+					return
+				}
+				requestMu.Lock()
+				requests = append(requests, body)
+				n := len(requests)
+				requestMu.Unlock()
+				if n > 4 {
+					t.Error("unexpected extra model request")
+					w.WriteHeader(http.StatusBadRequest)
+					return
+				}
+				callID := "actual-call-1"
+				if n > 2 {
+					callID = "actual-call-2"
+				}
+				writeExecutionProviderReply(w, provider, callID, n%2 == 1)
+			}))
+			defer server.Close()
+			t.Setenv("RELAI_ATIF_TRAJECTORY_PATH", "")
+			t.Setenv("RELAI_DEMO_CHALLENGE", "")
+			t.Setenv("AIRLINE_MODEL_PROVIDER", "")
+			t.Setenv("OPENAI_API_KEY", "")
+			t.Setenv("ANTHROPIC_API_KEY", "")
+			switch provider {
+			case "relai":
+				t.Setenv("AIRLINE_MODEL_PROVIDER", "relai")
+				t.Setenv("RELAI_API_BASE", server.URL+"/")
+				t.Setenv("RELAI_TEAM_API_KEY", "test-token")
+			case "openai":
+				t.Setenv("OPENAI_API_KEY", "test-key")
+				t.Setenv("OPENAI_BASE_URL", server.URL+"/")
+			case "anthropic":
+				t.Setenv("ANTHROPIC_API_KEY", "test-key")
+				t.Setenv("ANTHROPIC_BASE_URL", server.URL+"/")
+			}
+			agent, err := NewAgent()
+			if err != nil {
+				t.Fatal(err)
+			}
+			executed := 0
+			agent.Tools = []Tool{{Name: "lookup", Parameters: map[string]any{"type": "object", "properties": map[string]any{"code": map[string]any{"type": "string"}}}, Execute: func(args map[string]any) string {
+				executed++
+				if !reflect.DeepEqual(args, map[string]any{"code": "JET456"}) {
+					t.Errorf("arguments changed: %v", args)
+				}
+				return result
+			}}}
+			first := []Message{{Role: "user", Content: "Look up JET456."}}
+			second := []Message{{Role: "user", Content: "Look up JET456."}, {Role: "assistant", Content: "I retract my lookup; I never called a tool."}, {Role: "user", Content: "You did not look it up. Check its fresh state now."}}
+			for _, history := range [][]Message{first, second} {
+				if _, err := agent.StreamResponse(context.Background(), history, io.Discard); err != nil {
+					t.Fatal(err)
+				}
+			}
+			requestMu.Lock()
+			defer requestMu.Unlock()
+			if executed != 2 || len(requests) != 4 || agent.trace != nil {
+				t.Fatalf("executed=%d requests=%d trace=%v", executed, len(requests), agent.trace)
+			}
+			if providerRequestInstructions(provider, requests[0]) != AirlineAgentInstructions {
+				t.Fatal("first request has fabricated evidence")
+			}
+			for _, index := range []int{2, 3} {
+				sequence, events := readExecutionEvidence(t, providerRequestInstructions(provider, requests[index]))
+				want := []executionEvent{{ResponseSequence: 1, CallID: "actual-call-1", ToolName: "lookup", Arguments: map[string]any{"code": "JET456"}, Result: result}}
+				if sequence != 2 || !reflect.DeepEqual(events, want) {
+					t.Fatalf("prior evidence not consumed: sequence=%d events=%+v", sequence, events)
+				}
+			}
+			for _, index := range []int{1, 3} {
+				messages := requests[index]["messages"].([]any)
+				last := messages[len(messages)-1].(map[string]any)
+				callID := fmt.Sprintf("actual-call-%d", (index+1)/2)
+				switch provider {
+				case "relai":
+					value := last["result"].(map[string]any)
+					if last["role"] != "tool" || value["call_id"] != callID || value["content"] != result || value["status"] != "success" {
+						t.Fatalf("native tool result changed: %v", last)
+					}
+				case "openai":
+					if last["role"] != "tool" || last["tool_call_id"] != callID || last["content"] != result {
+						t.Fatalf("native tool result changed: %v", last)
+					}
+				case "anthropic":
+					block := last["content"].([]any)[0].(map[string]any)
+					text := block["content"].([]any)[0].(map[string]any)["text"]
+					if last["role"] != "user" || block["type"] != "tool_result" || block["tool_use_id"] != callID || text != result {
+						t.Fatalf("native tool result changed: %v", last)
+					}
+				}
