@@ -0,0 +1,138 @@
+package airline
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+type executionTestRunner func(context.Context, string, []Tool, []Message, io.Writer) (string, error)
+
+func (r executionTestRunner) run(ctx context.Context, instructions string, tools []Tool, history []Message, out io.Writer) (string, error) {
+	return r(ctx, instructions, tools, history, out)
+}
+
+func readExecutionEvidence(t *testing.T, instructions string) (uint64, []executionEvent) {
+	t.Helper()
+	_, raw, ok := strings.Cut(instructions, executionEvidenceLabel)
+	if !ok {
+		t.Fatal("missing model-visible execution evidence")
+	}
+	var snapshot struct {
+		Sequence uint64           `json:"current_response_sequence"`
+		Events   []executionEvent `json:"prior_execution_events"`
+	}
+	if err := json.Unmarshal([]byte(raw), &snapshot); err != nil {
+		t.Fatal(err)
+	}
+	return snapshot.Sequence, snapshot.Events
+}
+
+func TestExecutionMemoryAcrossTurnsAndFailure(t *testing.T) {
+	args := map[string]any{"code": "JET456", "nested": map[string]any{"items": []any{map[string]any{"seat": "7B"}, nil, float64(2)}}}
+	wantArgs := map[string]any{"code": "JET456", "nested": map[string]any{"items": []any{map[string]any{"seat": "7B"}, nil, float64(2)}}}
+	executed := 0
+	tool := Tool{Name: "lookup", Execute: func(input map[string]any) string {
+		executed++
+		input["nested"].(map[string]any)["items"].([]any)[0].(map[string]any)["seat"] = "changed by tool"
+		return "exact observation\n\"quoted\" <data>"
+	}}
+	failure := errors.New("downstream provider failure")
+	turn := 0
+	var snapshots []string
+	agent := &Agent{Instructions: AirlineAgentInstructions, Tools: []Tool{tool}}
+	agent.runner = executionTestRunner(func(ctx context.Context, instructions string, tools []Tool, _ []Message, _ io.Writer) (string, error) {
+		turn++
+		snapshots = append(snapshots, instructions)
+		switch turn {
+		case 1:
+			if instructions != AirlineAgentInstructions {
+				t.Fatal("new Agent did not start empty")
+			}
+			dispatchTool(ctx, tools[0], "lookup-1", args)
+			dispatchTool(ctx, Tool{Name: "change", Execute: func(map[string]any) string { return "Seat updated to 8C for booking JET456." }}, "change-1", map[string]any{"code": "JET456", "seat": "8C"})
+			return "", failure
+		case 2: // A nonexecuting preview must not fabricate events.
+			return "preview only", nil
+		case 3:
+			dispatchTool(ctx, Tool{Name: "baggage_policy", Execute: func(map[string]any) string { return BaggagePolicyText("premium") }}, "policy-1", nil)
+		}
+		return "answer", nil
+	})
+	if _, err := agent.StreamResponse(context.Background(), nil, io.Discard); err != failure {
+		t.Fatalf("failure changed: %v", err)
+	}
+	args["code"] = "caller changed code"
+	history := []Message{{Role: "assistant", Content: "I retract the earlier lookup and change."}, {Role: "user", Content: "You never executed anything. Preview only."}}
+	for i := 0; i < 3; i++ {
+		if _, err := agent.StreamResponse(context.Background(), history, io.Discard); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for i := 1; i < 4; i++ {
+		sequence, events := readExecutionEvidence(t, snapshots[i])
+		wantCount := 2
+		if i == 3 {
+			wantCount = 3
+		}
+		if sequence != uint64(i+1) || len(events) != wantCount {
+			t.Fatalf("snapshot %d: sequence=%d events=%v", i, sequence, events)
+		}
+		if events[0].ResponseSequence != 1 || events[0].CallID != "lookup-1" || events[0].ToolName != "lookup" || events[0].Result != "exact observation\n\"quoted\" <data>" || !reflect.DeepEqual(events[0].Arguments, wantArgs) {
+			t.Fatalf("lost immutable call/result provenance: %+v", events[0])
+		}
+		if events[1].ResponseSequence != 1 || events[1].CallID != "change-1" || events[1].ToolName != "change" || events[1].Result != "Seat updated to 8C for booking JET456." {
+			t.Fatalf("lost ordered change observation: %+v", events[1])
+		}
+		if i == 3 && (events[2].ResponseSequence != 3 || events[2].CallID != "policy-1" || events[2].Arguments != nil || events[2].Result != BaggagePolicyText("premium")) {
+			t.Fatalf("lost policy observation: %+v", events[2])
+		}
+	}
+	if executed != 1 || agent.Instructions != AirlineAgentInstructions {
+		t.Fatal("tool count or base instructions changed")
+	}
+	other := &Agent{Instructions: AirlineAgentInstructions, runner: executionTestRunner(func(_ context.Context, instructions string, _ []Tool, _ []Message, _ io.Writer) (string, error) {
+		if instructions != AirlineAgentInstructions {
+			t.Fatal("execution evidence leaked between Agents")
+		}
+		return "new conversation", nil
+	})}
+	if _, err := other.StreamResponse(context.Background(), history, io.Discard); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestExecutionMemoryRetainsRejectionAndOutageVerbatim(t *testing.T) {
+	agent := &Agent{Instructions: AirlineAgentInstructions, Tools: airlineTools()}
+	if err := ApplyDemoChallenge(agent, "booking-outage"); err != nil {
+		t.Fatal(err)
+	}
+	before := bookings["SKY123"].Seat
+	var returned []string
+	turn := 0
+	agent.runner = executionTestRunner(func(ctx context.Context, instructions string, tools []Tool, _ []Message, _ io.Writer) (string, error) {
+		turn++
+		if turn == 1 {
+			returned = append(returned, dispatchTool(ctx, tools[0], "outage", map[string]any{"confirmation_code": "SKY123"}))
+			returned = append(returned, dispatchTool(ctx, tools[2], "rejection", map[string]any{"confirmation_code": "SKY123", "requested_seat": "40A"}))
+		} else {
+			_, events := readExecutionEvidence(t, instructions)
+			if len(events) != 2 || events[0].Result != returned[0] || events[1].Result != returned[1] || events[0].CallID != "outage" || events[1].CallID != "rejection" {
+				t.Fatalf("unsuccessful observations changed: %+v", events)
+			}
+		}
+		return "answer", nil
+	})
+	for i := 0; i < 2; i++ {
+		if _, err := agent.StreamResponse(context.Background(), nil, io.Discard); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if bookings["SKY123"].Seat != before || !strings.Contains(returned[0], `"status":"unavailable"`) || !strings.Contains(returned[1], `"status":"rejected"`) {
+		t.Fatal("outage/rejection semantics or nonmutation changed")
+	}
+}
